def _sha(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()

def generate() -> dict:
    fixtures: dict = {}
    for fid, (fname, exp_len, exp_hash) in PINNED.items():
        data = json.loads((_FIXTURE_DIR / fname).read_text(encoding="utf-8"))
        txt = data["prompt_text"]
        if len(txt) != exp_len: raise SystemExit(f"{fid}: len mismatch")
        if _sha(txt) != exp_hash: raise SystemExit(f"{fid}: hash mismatch")
        fixtures[fid] = {"fixture_file": fname, "prompt_body_sha256": exp_hash, "fields": []}

    for fid, field_id, needle, occ in NEEDLES:
        entry = fixtures[fid]
        txt_data = json.loads((_FIXTURE_DIR / entry["fixture_file"]).read_text(encoding="utf-8"))
        txt = txt_data["prompt_text"]
        idx, count = -1, 0
        while True:
            idx = txt.find(needle, idx + 1)
            if idx < 0: break
            if count == occ: break
            count += 1
        if idx < 0:
            raise SystemExit(f"NOT FOUND: {fid}.{field_id} = '{needle}'")
        start, end = idx, idx + len(needle)
        exact = txt[start:end]
        entry["fields"].append({
            "fixture_id": fid, "prompt_body_sha256": entry["prompt_body_sha256"],
            "start": start, "end": end, "exact_text": exact,
            "exact_text_sha256": _sha(exact), "field_id": f"{fid}.{field_id}",
        })

    for fid in fixtures:
        fixtures[fid]["fields"].sort(key=lambda f: f["field_id"])
    return {"schema_version": "1.0", "fixtures": fixtures}

if __name__ == "__main__":
    registry = generate()
    _OUTPUT.write_text(json.dumps(registry, ensure_ascii=False, indent=2), encoding="utf-8")
    total = sum(len(v["fields"]) for v in registry["fixtures"].values())
    print(f"Generated {total} fields across {len(registry['fixtures'])} fixtures")
