{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mode-p.internal/shot_manifest/v1",
  "title": "SHOT_MANIFEST",
  "description": "Mechanical projection of DIRECTOR_MASTER.md canonical fields. Generated by master_compiler; contains no creative text. Not delivered to end users.",
  "type": "object",
  "required": ["manifest_version", "scene_id", "master_version", "master_content_hash", "compiler_version", "shots"],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$",
      "description": "Manifest schema version. Minor bumps for new optional fields; this file is v1.x."
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Scene identifier from SCRIPT_FACTS."
    },
    "master_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+/v\\d+\\.\\d+$",
      "description": "Master version this manifest was compiled from, e.g. EP14_S1/v1.0."
    },
    "master_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the canonical Master file content at compile time."
    },
    "compiler_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of master_compiler that produced this manifest."
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per Shot in Master order. Index 0 = Shot 1.",
      "items": {
        "$ref": "#/$defs/shot_entry"
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 2,
      "description": "Active v4 Masters expose one shared Boundary source for scene entry, every cut, and scene exit. Historical v1.1 manifests omit this field.",
      "items": {
        "$ref": "#/$defs/boundary_entry"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest_version": { "const": "1.2" }
        },
        "required": ["manifest_version"]
      },
      "then": {
        "required": ["boundaries"]
      }
    }
  ],
  "$defs": {
    "shot_entry": {
      "type": "object",
      "required": [
        "shot_id", "duration", "scene_expression", "timing_mode",
        "story_fact_ref", "opening_state_keys", "closing_state_keys",
        "entry_boundary_id", "exit_boundary_id", "transition_execution",
        "boundary_continuity", "generation_mode", "reference_assets"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+-\\d+$",
          "description": "Canonical shot identifier, e.g. EP14_S1-3."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 15,
          "description": "Shot duration in seconds."
        },
        "scene_expression": {
          "type": "string",
          "enum": [
            "conversation_power",
            "crowd_attention",
            "action_chase",
            "suspense_reveal",
            "contemplative_silence",
            "investigation_object",
            "montage",
            "cross_space_transition"
          ]
        },
        "timing_mode": {
          "type": "string",
          "enum": ["event_nodes", "second_nodes", "half_second_nodes"]
        },
        "story_fact_ref": {
          "type": "object",
          "required": ["text_start", "source_scene_id", "source_line_start", "source_line_end"],
          "properties": {
            "text_start": {
              "type": "string",
              "minLength": 1,
              "description": "First 80 chars of the story_fact text, for traceability."
            },
            "source_scene_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "source_line_start": {
              "type": "integer",
              "minimum": 1
            },
            "source_line_end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "opening_state_keys": {
          "type": "object",
          "required": ["characters", "props", "light_main", "action_phase"],
          "properties": {
            "characters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["entity_id", "position", "facing", "screen_direction", "posture"],
                "properties": {
                  "entity_id": { "type": "string", "minLength": 1 },
                  "position": { "type": "string" },
                  "facing": { "type": "string" },
                  "screen_direction": {
                    "type": "string",
                    "enum": ["left_to_right", "right_to_left", "depth_in", "depth_out", "static"]
                  },
                  "posture": { "type": "string" }
                  ,"wardrobe": { "type": "string", "minLength": 1 }
                  ,"injury": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["prop_id", "held_by", "location"],
                "properties": {
                  "prop_id": { "type": "string", "minLength": 1 },
                  "held_by": { "type": "string" },
                  "location": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "light_main": {
              "type": "object",
              "required": ["direction", "color_temp_k", "ratio"],
              "properties": {
                "direction": { "type": "string" },
                "color_temp_k": { "type": "integer", "minimum": 1000, "maximum": 20000 },
                "ratio": { "type": "string", "pattern": "^1:\\d+(\\.\\d+)?$" }
              },
              "additionalProperties": false
            },
            "action_phase": {
              "type": "string",
              "enum": ["prepare", "launch", "travel", "impact", "recover", "static"]
            },
            "story_time": { "type": "string", "minLength": 1 },
            "weather": { "type": "string", "minLength": 1 },
            "environment": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "closing_state_keys": {
          "type": "object",
          "required": ["characters", "props", "light_main", "action_phase"],
          "properties": {
            "characters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["entity_id", "position", "facing", "screen_direction", "posture"],
                "properties": {
                  "entity_id": { "type": "string", "minLength": 1 },
                  "position": { "type": "string" },
                  "facing": { "type": "string" },
                  "screen_direction": {
                    "type": "string",
                    "enum": ["left_to_right", "right_to_left", "depth_in", "depth_out", "static"]
                  },
                  "posture": { "type": "string" }
                  ,"wardrobe": { "type": "string", "minLength": 1 }
                  ,"injury": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["prop_id", "held_by", "location"],
                "properties": {
                  "prop_id": { "type": "string", "minLength": 1 },
                  "held_by": { "type": "string" },
                  "location": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "light_main": {
              "type": "object",
              "required": ["direction", "color_temp_k", "ratio"],
              "properties": {
                "direction": { "type": "string" },
                "color_temp_k": { "type": "integer", "minimum": 1000, "maximum": 20000 },
                "ratio": { "type": "string", "pattern": "^1:\\d+(\\.\\d+)?$" }
              },
              "additionalProperties": false
            },
            "action_phase": {
              "type": "string",
              "enum": ["prepare", "launch", "travel", "impact", "recover", "static"]
            },
            "story_time": { "type": "string", "minLength": 1 },
            "weather": { "type": "string", "minLength": 1 },
            "environment": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "entry_boundary_id": {
          "type": "string",
          "pattern": "^(SCENE_ENTRY|[A-Za-z0-9_-]+-(?:\\d+|B\\d+))$",
          "description": "Boundary reference. Active v4 manifests use <scene_id>-B<N>; historical manifests may use SCENE_ENTRY or Shot IDs."
        },
        "exit_boundary_id": {
          "type": "string",
          "pattern": "^(SCENE_EXIT|[A-Za-z0-9_-]+-(?:\\d+|B\\d+))$",
          "description": "Boundary reference. Active v4 manifests use <scene_id>-B<N>; historical manifests may use SCENE_EXIT or Shot IDs."
        },
        "boundary_continuity": {
          "type": "string",
          "enum": ["continuous", "elliptical", "scene_exit"],
          "description": "Outgoing boundary relation. Exact state checks apply only to continuous; the last shot uses scene_exit."
        },
        "transition_execution": {
          "type": "string",
          "enum": ["in_camera", "post_production"]
        },
        "generation_mode": {
          "type": "string",
          "enum": ["text_only", "first_last_frame", "omni_reference"]
        },
        "reference_assets": {
          "type": "array",
          "description": "Asset IDs from ASSET_INDEX, or empty array for text_only mode.",
          "items": {
            "type": "object",
            "required": ["asset_id", "responsibility"],
            "properties": {
              "asset_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "responsibility": {
                "type": "string",
                "enum": ["identity", "wardrobe", "location", "continuity", "action", "camera", "style", "audio", "first_frame", "last_frame"],
                "description": "What this asset constrains. Stored in manifest for traceability; creative rationale stays in Master."
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "boundary_entry": {
      "type": "object",
      "required": [
        "boundary_id", "from_ref", "to_ref", "relation",
        "transition_execution", "outgoing_state_keys", "incoming_state_keys"
      ],
      "properties": {
        "boundary_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+-B\\d+$"
        },
        "from_ref": {
          "type": "string",
          "pattern": "^(SCENE_ENTRY|[A-Za-z0-9_-]+-\\d+)$"
        },
        "to_ref": {
          "type": "string",
          "pattern": "^(SCENE_EXIT|[A-Za-z0-9_-]+-\\d+)$"
        },
        "relation": {
          "type": "string",
          "enum": ["scene_entry", "continuous", "elliptical", "scene_exit"]
        },
        "transition_execution": {
          "type": "string",
          "enum": ["in_camera", "post_production"]
        },
        "outgoing_state_keys": {
          "oneOf": [
            { "$ref": "#/$defs/state_keys" },
            { "type": "null" }
          ]
        },
        "incoming_state_keys": {
          "oneOf": [
            { "$ref": "#/$defs/state_keys" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "state_keys": {
      "type": "object",
      "required": ["characters", "props", "light_main", "action_phase"],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_id", "position", "facing", "screen_direction", "posture"],
            "properties": {
              "entity_id": { "type": "string", "minLength": 1 },
              "position": { "type": "string" },
              "facing": { "type": "string" },
              "screen_direction": {
                "type": "string",
                "enum": ["left_to_right", "right_to_left", "depth_in", "depth_out", "static"]
              },
              "posture": { "type": "string" },
              "wardrobe": { "type": "string", "minLength": 1 },
              "injury": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["prop_id", "held_by", "location"],
            "properties": {
              "prop_id": { "type": "string", "minLength": 1 },
              "held_by": { "type": "string" },
              "location": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "light_main": {
          "type": "object",
          "required": ["direction", "color_temp_k", "ratio"],
          "properties": {
            "direction": { "type": "string" },
            "color_temp_k": { "type": "integer", "minimum": 1000, "maximum": 20000 },
            "ratio": { "type": "string", "pattern": "^1:\\d+(\\.\\d+)?$" }
          },
          "additionalProperties": false
        },
        "action_phase": {
          "type": "string",
          "enum": ["prepare", "launch", "travel", "impact", "recover", "static"]
        },
        "story_time": { "type": "string", "minLength": 1 },
        "weather": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
